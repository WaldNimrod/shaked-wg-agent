# aos-api-v5.service — AOS v5 API + cockpit, parallel-run on :8092 (DB aos_v5, shared PG :5434).
#
# Runs ALONGSIDE v4's aos-api.service (:8090 / aos_v3) — fully isolated: separate unit name,
# separate port, separate DB NAME (database-name isolation on the same cluster), separate checkout.
# Dropping this unit cannot regress v4.
#
# Render placeholders before install (→ /etc/systemd/system/aos-api-v5.service):
#   {{REPO_ROOT}}  e.g. /data/projects/agents-os-v5   (the v5 worktree: recover/v5-work-2026-06-08)
#   {{VENV}}       e.g. /data/projects/agents-os/.venv (reuse v4's venv — v5's `mcp` import is lazy,
#                  so the API starts without it; if a v5-only EAGER dep is ever needed, point this at a
#                  dedicated /data/projects/agents-os-v5/.venv and `pip install -r core/requirements.txt`).
#   {{USER}}       e.g. nimrodw
#
# Calls uvicorn DIRECTLY (not scripts/start_aos_api_local.sh, which defaults to a 410-stub unless
# AOS_DEV_MODE=1). core/api.py:create_app() mounts /cockpit + /dashboard unconditionally. Module path
# `core.modules.management.api:app` (no agents_os symlink dependency — matches the v4 unit).
#
# Production posture (team_00 GO 2026-06-19): host 0.0.0.0, reachable ONLY over the Tailscale tailnet
# (no inbound WAN port). Actor keys ENFORCED (fail-closed): core/.env carries AOS_ACTOR_KEYS and
# does NOT set AOS_TRUST_CLIENT_ACTOR. No reverse proxy (matches v4; tailnet is the perimeter).
[Unit]
Description=AOS v5 API + cockpit (parallel-run, :8092, DB aos_v5)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{REPO_ROOT}}
# core/.env (v5 copy) holds AOS_DATABASE_URL (canonical, M9-P2-WP7) → aos_v5; legacy AOS_DATABASE_URL
# fallback + AOS_ACTOR_KEYS. Literal KEY=value lines
# only (systemd EnvironmentFile does no shell expansion) — the repo .env already is in that form.
EnvironmentFile={{REPO_ROOT}}/core/.env
Environment=PYTHONPATH={{REPO_ROOT}}
ExecStart={{VENV}}/bin/uvicorn core.modules.management.api:app --host 0.0.0.0 --port 8092 --workers 1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
