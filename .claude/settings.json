{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(python -m *)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(.venv/bin/pip *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(cp *)",
      "Bash(rm *)",
      "Bash(find *)",
      "Bash(bash _aos/lean-kit/modules/validation-quality/scripts/validate_aos.sh *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge:*)",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/gh_merge_guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
